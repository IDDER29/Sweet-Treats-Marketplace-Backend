<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Order Status Update</title>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f2f0f1; -webkit-font-smoothing: antialiased;">
    <!-- preheader (hidden preview text) -->
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0;">
      There's an update on your Sweet Treats order.
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color: #f2f0f1;">
      <tr>
        <td align="center" style="padding: 24px 12px;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width: 600px; max-width: 600px; background-color: #ffffff; border-radius: 10px; overflow: hidden; font-family: -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;">

            <!-- header -->
            <tr>
              <td align="center" style="background-color: #d6336c; padding: 26px 24px;">
                <div style="font-size: 22px; font-weight: 700; color: #ffffff; letter-spacing: 0.3px;">🧁 Sweet Treats</div>
                <div style="margin-top: 5px; font-size: 11px; color: #ffd9e6; letter-spacing: 1.5px; text-transform: uppercase;">Handmade treats, delivered</div>
              </td>
            </tr>

            <!-- hero -->
            <tr>
              <td style="padding: 36px 32px 8px 32px;">
                <h1 style="margin: 0; font-size: 24px; line-height: 1.3; color: #2b2b2b;">Order update</h1>
              </td>
            </tr>

            <!-- body -->
            <tr>
              <td style="padding: 8px 32px 0 32px; font-size: 15px; line-height: 1.6; color: #555555;">
                <p style="margin: 0 0 24px 0;">Hi {{customerName}}, there's an update on your order.</p>
              </td>
            </tr>

            <!-- status card -->
            <tr>
              <td style="padding: 0 32px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border: 1px solid #eeeeee; border-radius: 8px;">
                  <tr>
                    <td align="center" style="padding: 28px 18px;">
                      <div style="font-size: 13px; color: #888888;">Order #{{orderId}} is now</div>
                      <div style="margin-top: 12px;">
                        <span style="display: inline-block; padding: 8px 20px; background-color: #fce4ec; color: #b02a5b; font-size: 16px; font-weight: 700; letter-spacing: 0.5px; border-radius: 999px;">{{status}}</span>
                      </div>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- closing -->
            <tr>
              <td style="padding: 28px 32px 36px 32px; font-size: 15px; line-height: 1.6; color: #555555;">
                <p style="margin: 0;">We'll keep you posted on any further changes. Thanks for ordering with us! 💕</p>
              </td>
            </tr>

            <!-- footer -->
            <tr>
              <td style="padding: 24px 32px; background-color: #faf6f8; border-top: 1px solid #f0e8ec; font-size: 12px; line-height: 1.5; color: #999999;" align="center">
                Sweet Treats Marketplace<br />
                This is an automated message — please don't reply to this email.
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
