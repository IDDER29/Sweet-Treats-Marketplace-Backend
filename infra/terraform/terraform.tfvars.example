# Copy to terraform.tfvars and adjust. Secrets (DB password, JWT secret) are
# generated by Terraform and stored in Secrets Manager — none live here.

region              = "eu-west-1"
project             = "sweet-treats"
environment         = "production"
image_tag           = "REPLACE_WITH_GIT_SHA"
allowed_origins     = "https://app.sweet-treats.example"
acm_certificate_arn = "arn:aws:acm:eu-west-1:000000000000:certificate/REPLACE"

# Capacity (tune per load)
api_desired_count    = 2
worker_desired_count = 1
task_cpu             = 512
task_memory          = 1024
db_instance_class    = "db.t4g.medium"
redis_node_type      = "cache.t4g.small"
