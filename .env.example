# Copy to .env and fill in. The app reads these directly from process.env
# (@nestjs/config, global). See CLAUDE.md for details.

# --- Database (PostgreSQL, required) ---
# The app has no in-memory fallback; a reachable DB is required to boot.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=sweet_treats

# --- Runtime ---
# Unset / non-"production" => TypeORM synchronize is ON (auto-creates tables).
# "production" => synchronize OFF and migrationsRun ON (runs dist/migrations/*.js).
NODE_ENV=development

# --- Redis (cache, distributed rate limiting; later: queues, refresh tokens) ---
# Optional in dev: if unset, caching becomes a no-op and rate limiting falls
# back to in-memory. Required in production for limits to hold across replicas.
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Signing secret for user & business JWTs. If unset, the code falls back to the
# insecure literal 'mySecretKey' (a startup warning is logged). Always set this.
JWT_SECRET=change-me

# --- CORS / links ---
# Comma-separated allowed origins (defaults to localhost:3000,3001 if unset).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Used to build links in outbound emails (e.g. password reset).
FRONTEND_URL=http://localhost:3001

# --- Email (SMTP) ---
# Defaults to localhost:1025 (e.g. MailHog). Mail failures are non-fatal.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASS=
MAIL_FROM="Sweet Treats <noreply@sweettreats.local>"

# --- Payments (Stripe) ---
# If unset, a placeholder is used so the app can boot; real payment calls will
# fail with a Stripe auth error until a valid key is provided.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Object storage (S3-compatible, for uploads) ---
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_CDN_URL=
